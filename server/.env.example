# Server: copy this file to .env (git-ignored).

# Dashboard origins allowed to call the API (comma-separated).
# Add http://<laptop-ip>:5173 if you open the dashboard from another device.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# OpenRouteService key (openrouteservice.org, free tier). Destination search and walking routes.
ORS_API_KEY=your_ors_key

# Where reports.json and photos/ are written (git-ignored). Default ../db
STORAGE_DIR=../db

# Reports are accepted inside: west,south,east,north. Mirrors dashboard/src/config/makati.ts.
CITY_BOUNDS=120.9987,14.5296,121.0501,14.5796

# The ticket loop: 1 gives every new report its ticket, district and priority (db/lakad.db) within a few seconds.
TICKETS_SYNC=1
