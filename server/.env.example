# Server: copy this file to .env (git-ignored).

HOST=0.0.0.0
PORT=8000

# Dashboard dev servers allowed to call the API (comma-separated).
# Add http://<laptop-ip>:5173 and :5174 if you open a dashboard from another device.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# TomTom key. Only needed if the server proxies traffic (app/routers/traffic.py).
TOMTOM_API_KEY=your_tomtom_key

# Map data. Change the place name to build the walk network for another city.
OSM_PLACE="Makati, Metro Manila, Philippines"
GRAPH_CACHE_PATH=data/makati_walk.graphml

# Storage: SQLite and photos on disk, created at runtime.
DB_PATH=storage/lakad.db
PHOTO_DIR=storage/photos
