# dashboard: copy this file to .env.local (git-ignored).
# Vite only exposes variables that start with VITE_.

# Mapbox public token (pk.), from account.mapbox.com
VITE_MAPBOX_TOKEN=pk.your_public_token

# TomTom key for the congestion layer, from developer.tomtom.com
VITE_TOMTOM_API_KEY=your_tomtom_key

# Lakad API. Use the laptop's hotspot IP instead of localhost
# if you open this dashboard from another device.
VITE_API_BASE_URL=http://localhost:8000

# Analyst sign-in (Supabase Auth); see supabase/README.md. Leave both empty to run
# without sign-in, as before. Set both and the dashboard asks analysts to sign in,
# then shows only their district's tickets.
# Supabase dashboard: the project's Connect button, or Project Settings > Data API
# (URL) and Project Settings > API Keys (publishable key).
# Only the PUBLISHABLE key (sb_publishable_...) belongs here: it ships to every browser.
# Never put the secret or service_role key in this file or anywhere in the dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
